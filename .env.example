# Provider credentials. Never commit real keys.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model availability and pricing are controlled by OpenRouter.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=high
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180

# Docker and reverse-proxy settings
SITE_ADDRESS=http://:80
PUBLIC_HTTP_PORT=8080
STREAMLIT_HOST_PORT=8601
